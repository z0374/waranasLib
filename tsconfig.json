{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
  },
  "include": [
    "main.index.ts",
    "globals.ts",
    "interface.index.ts",
    "types.index.ts",
    "src/**/*.ts",
  ],
  "exclude": ["node_modules", ".wrangler"],
}
